{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Afterlight local CCTV GeoJSON",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "required": ["geometry", "properties"],
        "properties": {
          "id": { "type": ["string", "number"] },
          "geometry": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Point" }, "coordinates": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "[longitude, latitude] within the imported Mumbai bounding box" } } },
          "properties": {
            "type": "object", "required": ["source", "licence"],
            "properties": {
              "name": { "type": "string" }, "source": { "type": "string", "format": "uri" }, "licence": { "type": "string", "minLength": 1 },
              "operator": { "type": "string" }, "type": { "type": "string" }, "updated": { "type": "string", "format": "date-time" }, "checked": { "type": "string", "format": "date" },
              "status": { "enum": ["unverified", "reported_active", "reported_inactive"] }
            }
          }
        }
      }
    }
  }
}
