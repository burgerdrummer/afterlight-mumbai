{
  "name": "afterlight-mumbai",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "router": "node scripts/start-router.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/core/*.test.ts",
    "refresh:hours": "python scripts/refresh_opening_hours.py --fetch",
    "audit:data": "node scripts/audit-data.mjs",
    "refresh:data": "python scripts/refresh_data.py",
    "import:mumbai": "python scripts/download_city.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "maplibre-gl": "^6.16.0",
    "lucide-react": "^0.468.0",
    "opening_hours": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "tsx": "^4.20.0"
  }
}
